{
  "name": "@vorimai/zeko-agent-trust-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VorimAI agent identity, scoped permission, and signed-audit demo for Zeko.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:upstream-mba": "npm --prefix vendor/agent-mission-bound-auth run zkapp:build",
    "demo": "npm run build && node build/scripts/demo-local.js",
    "demo:vorim": "npm run build && node build/scripts/demo-vorim-zeko.js",
    "poc:finfindr": "npm run build && node build/pocs/finfindr/run.js",
    "poc:finfindr:app": "npm run build && node build/pocs/finfindr/server.js",
    "poc:kent-ai": "npm run build && node build/pocs/kent-ai/run.js",
    "poc:kent-ai:app": "npm run build && node build/pocs/kent-ai/server.js",
    "app": "npm run build && node build/scripts/demo-app-server.js",
    "doctor": "npm run build && node build/scripts/doctor.js",
    "test": "npm run build && node --test build/test/customer-pocs.test.js build/test/vorim-agent-trust-registry.test.js build/test/vorim-zeko-adapter.test.js",
    "test:upstream-mba": "npm --prefix vendor/agent-mission-bound-auth run test:zkapp-trustless",
    "deploy:zeko": "npm --prefix vendor/agent-mission-bound-auth run zkapp:deploy",
    "smoke:zeko": "npm --prefix vendor/agent-mission-bound-auth run smoke:live-approval-anchor",
    "deploy:adapter-demo": "npm run build && node build/scripts/deploy-zeko.js",
    "smoke:adapter-demo": "npm run build && node build/scripts/smoke-zeko.js"
  },
  "dependencies": {
    "agent-mission-bound-auth": "https://github.com/Evan-k-global/agent-mission-bound-auth/archive/1295b9b725974a7f15046fc503d79eac28b49744.tar.gz",
    "dotenv": "^16.4.7",
    "o1js": "2.14.0",
    "reflect-metadata": "^0.2.2",
    "zeko-x402": "https://github.com/zeko-labs/x402-zeko/archive/f7d4ea765e9fc0a55e38fd93d3d9f55313ece1da.tar.gz"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
